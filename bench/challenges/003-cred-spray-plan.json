{
  "id": "003-cred-spray-plan",
  "name": "Generate credential spray plan from engagement state",
  "category": "credential_reuse",
  "difficulty": 2,
  "description": "Given an engagement with discovered services and a credential, generate a spray plan covering all eligible targets.",
  "setup": {
    "engagement_name": "bench-003",
    "hosts": {
      "10.10.10.5": {
        "services": [
          {"port": 445, "service": "microsoft-ds", "protocol": "tcp"},
