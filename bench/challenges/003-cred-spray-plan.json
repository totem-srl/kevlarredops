          {"port": 3306, "service": "mysql", "protocol": "tcp"}
        ]
      },
      "10.10.10.7": {
        "services": [
          {"port": 445, "service": "microsoft-ds", "protocol": "tcp"},
          {"port": 1433, "service": "ms-sql-s", "protocol": "tcp"}
